<%-- Inclus en tête de chaque page. La page définit ${titre} avant l'include. --%>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${titre} · Gestion des patients</title>
    <%-- CSS inline : le FrontController est mappé sur "/" et intercepterait un fichier .css --%>
    <style>
        :root {
            --fond: #f4f6f8; --carte: #fff; --texte: #1f2933; --discret: #616e7c;
            --bordure: #d9e2ec; --accent: #0b6e4f; --accent-fonce: #08533c;
            --danger: #b42318; --danger-fond: #fef3f2;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
               background: var(--fond); color: var(--texte); font-size: 15px; }
        header { background: var(--accent); color: #fff; }
        header .barre { max-width: 1100px; margin: 0 auto; padding: 12px 16px;
                        display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
        header .logo { font-weight: 700; font-size: 17px; }
        header nav { display: flex; gap: 16px; flex: 1; }
        header a { color: #fff; text-decoration: none; opacity: .85; }
        header a:hover, header a.actif { opacity: 1; text-decoration: underline; }
        header .compte { font-size: 14px; display: flex; gap: 12px; align-items: center; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px;
                 font-weight: 600; background: #e3f8ef; color: var(--accent-fonce); }
        header .badge { background: rgba(255,255,255,.2); color: #fff; }
        main { max-width: 1100px; margin: 24px auto; padding: 0 16px; }
        h1 { font-size: 22px; margin: 0 0 16px; }
        h2 { font-size: 17px; margin: 28px 0 10px; }
        .carte { background: var(--carte); border: 1px solid var(--bordure); border-radius: 8px; }
        .entete-page { display: flex; justify-content: space-between; align-items: center;
                       gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
        .entete-page h1 { margin: 0; }
        .tableau { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--bordure);
                 white-space: nowrap; }
        th { font-size: 13px; color: var(--discret); font-weight: 600; background: #f9fafb; }
        tr:last-child td { border-bottom: none; }
        td.actions { display: flex; gap: 8px; }
        .vide { padding: 16px; color: var(--discret); }
        .bouton { display: inline-block; border: 1px solid var(--accent); background: var(--accent);
                  color: #fff; padding: 8px 14px; border-radius: 6px; font-size: 14px;
                  text-decoration: none; cursor: pointer; font-family: inherit; }
        .bouton:hover { background: var(--accent-fonce); }
        .bouton.secondaire { background: #fff; color: var(--accent); }
        .bouton.danger { background: #fff; color: var(--danger); border-color: var(--danger); }
        .bouton.petit { padding: 4px 10px; font-size: 13px; }
        form.en-ligne { margin: 0; }
        .erreur { background: var(--danger-fond); color: var(--danger); border: 1px solid #fecdca;
                  padding: 10px 12px; border-radius: 6px; margin-bottom: 16px; }
        .grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
        label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; }
        input, select { width: 100%; padding: 8px 10px; border: 1px solid var(--bordure);
                        border-radius: 6px; font-size: 15px; font-family: inherit; background: #fff; }
        input:focus, select:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
        .aide { font-size: 12px; color: var(--discret); margin-top: 4px; }
        .boutons { display: flex; gap: 8px; margin-top: 20px; }
    </style>
</head>
<body>
<c:if test="${not empty sessionScope.user}">
    <header>
        <div class="barre">
            <span class="logo">Gestion des patients</span>
            <nav>
                <a href="${pageContext.request.contextPath}/personnes">Personnes</a>
                <c:if test="${sessionScope.role == 'MEDECIN'}">
                    <a href="${pageContext.request.contextPath}/patients">Patients</a>
                </c:if>
            </nav>
            <span class="compte">
                <c:out value="${sessionScope.user}"/>
                <span class="badge"><c:out value="${sessionScope.role == 'MEDECIN' ? 'Médecin' : 'Patient'}"/></span>
                <a href="${pageContext.request.contextPath}/logout">Déconnexion</a>
            </span>
        </div>
    </header>
</c:if>
<main>
