<%-- Inclus en tete de chaque page. La page definit ${titre} (et ${menu} pour surligner
     l'onglet actif : "personnes" ou "patients") avant l'include. --%>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${titre} - Gestion des patients</title>
    <%-- CSS inline : le FrontController est mappe sur "/" et intercepterait un fichier .css --%>
    <style>
        :root {
            --fond: #f3f6f8; --carte: #ffffff; --texte: #14202b; --discret: #5b6b7a;
            --bordure: #e1e7ed; --survol: #f7f9fb;
            --accent: #0f766e; --accent-fonce: #0b5d57; --accent-doux: #e6f4f2;
            --bleu-doux: #e8f0fb; --bleu: #2457a6; --rose-doux: #fbebf1; --rose: #a3335e;
            --danger: #b42318; --danger-doux: #fef3f2; --danger-bord: #fbd2cd;
            --ombre: 0 1px 2px rgba(16, 32, 43, .05), 0 4px 16px rgba(16, 32, 43, .06);
            --rayon: 12px;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --fond: #0e1418; --carte: #151d23; --texte: #e6edf2; --discret: #93a3b1;
                --bordure: #26323c; --survol: #1b252d;
                --accent: #2bb3a3; --accent-fonce: #239a8c; --accent-doux: #12302d;
                --bleu-doux: #172a43; --bleu: #8db4ee; --rose-doux: #3a1a27; --rose: #ef9bbd;
                --danger: #f2877b; --danger-doux: #2c1614; --danger-bord: #5a2420;
                --ombre: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .25);
            }
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
               background: var(--fond); color: var(--texte); font-size: 15px; line-height: 1.5;
               -webkit-font-smoothing: antialiased; }
        a { color: var(--accent); }

        /* ---- Barre du haut ---- */
        header { background: var(--carte); border-bottom: 1px solid var(--bordure);
                 position: sticky; top: 0; z-index: 10; }
        header .barre { max-width: 1160px; margin: 0 auto; padding: 0 16px; height: 64px;
                        display: flex; align-items: center; gap: 28px; }
        .logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 16px;
                color: var(--texte); text-decoration: none; white-space: nowrap; }
        .logo-marque { width: 34px; height: 34px; border-radius: 9px; background: var(--accent);
                       display: grid; place-items: center; flex-shrink: 0; }
        header nav { display: flex; gap: 4px; flex: 1; }
        header nav a { color: var(--discret); text-decoration: none; font-weight: 500; font-size: 14px;
                       padding: 7px 12px; border-radius: 8px; }
        header nav a:hover { background: var(--survol); color: var(--texte); }
        header nav a.actif { background: var(--accent-doux); color: var(--accent); }
        .compte { display: flex; align-items: center; gap: 12px; }
        .compte-nom { display: flex; flex-direction: column; line-height: 1.2; text-align: right; }
        .compte-nom strong { font-size: 14px; }
        .compte-nom span { font-size: 12px; color: var(--discret); }
        .deconnexion { color: var(--discret); display: grid; place-items: center; width: 36px; height: 36px;
                       border-radius: 8px; border: 1px solid var(--bordure); }
        .deconnexion:hover { color: var(--danger); border-color: var(--danger-bord); background: var(--danger-doux); }

        /* ---- Contenu ---- */
        main { max-width: 1160px; margin: 32px auto 48px; padding: 0 16px; }
        h1 { font-size: 24px; margin: 0; letter-spacing: -.01em; }
        h2 { font-size: 16px; margin: 0; }
        .sous-titre { color: var(--discret); margin: 4px 0 0; font-size: 14px; }
        .entete-page { display: flex; justify-content: space-between; align-items: flex-end;
                       gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
        .carte { background: var(--carte); border: 1px solid var(--bordure); border-radius: var(--rayon);
                 box-shadow: var(--ombre); }
        .section { margin-top: 28px; }
        .section-titre { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }

        /* ---- Statistiques ---- */
        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
        .stat { padding: 18px 20px; display: flex; align-items: center; gap: 14px; }
        .stat-icone { width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center;
                      background: var(--accent-doux); color: var(--accent); flex-shrink: 0; }
        .stat-icone.bleu { background: var(--bleu-doux); color: var(--bleu); }
        .stat-icone.rose { background: var(--rose-doux); color: var(--rose); }
        .stat-valeur { font-size: 24px; font-weight: 700; line-height: 1.1; }
        .stat-libelle { font-size: 13px; color: var(--discret); }

        /* ---- Tableaux ---- */
        .tableau { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--bordure);
                 white-space: nowrap; vertical-align: middle; }
        th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--discret);
             font-weight: 600; background: var(--survol); }
        tbody tr:hover { background: var(--survol); }
        tr:last-child td { border-bottom: none; }
        .personne { display: flex; align-items: center; gap: 12px; }
        .avatar { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center;
                  font-size: 13px; font-weight: 700; background: var(--accent-doux); color: var(--accent);
                  flex-shrink: 0; }
        .avatar.medecin { background: var(--bleu-doux); color: var(--bleu); }
        .personne-nom { font-weight: 600; }
        .personne-email { font-size: 13px; color: var(--discret); }
        .discret { color: var(--discret); }
        .actions { display: flex; gap: 6px; justify-content: flex-end; }
        .vide { padding: 40px 16px; text-align: center; color: var(--discret); }

        /* ---- Pastilles ---- */
        .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px;
                 font-weight: 600; background: var(--accent-doux); color: var(--accent); }
        .badge.gris { background: var(--survol); color: var(--discret); border: 1px solid var(--bordure); }
        .badge.Masculin { background: var(--bleu-doux); color: var(--bleu); }
        .badge.Feminin { background: var(--rose-doux); color: var(--rose); }

        /* ---- Boutons ---- */
        .bouton { display: inline-flex; align-items: center; justify-content: center; gap: 6px;
                  border: 1px solid var(--accent); background: var(--accent); color: #fff;
                  padding: 9px 16px; border-radius: 8px; font-size: 14px; font-weight: 600;
                  text-decoration: none; cursor: pointer; font-family: inherit; line-height: 1.2; }
        .bouton:hover { background: var(--accent-fonce); border-color: var(--accent-fonce); }
        .bouton.secondaire { background: var(--carte); color: var(--texte); border-color: var(--bordure); }
        .bouton.secondaire:hover { background: var(--survol); }
        .bouton.danger { background: var(--carte); color: var(--danger); border-color: var(--danger-bord); }
        .bouton.danger:hover { background: var(--danger-doux); }
        .bouton.petit { padding: 6px 10px; font-size: 13px; }
        form.en-ligne { margin: 0; display: inline; }

        /* ---- Formulaires ---- */
        .erreur { display: flex; gap: 10px; align-items: flex-start; background: var(--danger-doux);
                  color: var(--danger); border: 1px solid var(--danger-bord); padding: 12px 14px;
                  border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
        .bloc { padding: 24px; border-bottom: 1px solid var(--bordure); }
        .bloc-titre { font-size: 15px; font-weight: 600; margin: 0 0 4px; }
        .bloc-aide { font-size: 13px; color: var(--discret); margin: 0 0 18px; }
        .grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
        .pleine { grid-column: 1 / -1; }
        label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
        .requis { color: var(--danger); }
        input, select { width: 100%; padding: 10px 12px; border: 1px solid var(--bordure);
                        border-radius: 8px; font-size: 15px; font-family: inherit;
                        background: var(--carte); color: var(--texte); }
        input:focus, select:focus { outline: none; border-color: var(--accent);
                                    box-shadow: 0 0 0 3px var(--accent-doux); }
        .aide { font-size: 12px; color: var(--discret); margin-top: 6px; }
        .boutons { display: flex; gap: 10px; justify-content: flex-end; padding: 16px 24px;
                   background: var(--survol); border-radius: 0 0 var(--rayon) var(--rayon); }

        /* ---- Pages centrees (connexion, erreur) ---- */
        .centre { min-height: calc(100vh - 80px); display: grid; place-items: center; }
        .boite { width: 100%; max-width: 420px; padding: 36px 32px; }
        .boite .logo { justify-content: center; margin-bottom: 24px; }
        .boite h1 { text-align: center; font-size: 22px; }
        .boite .sous-titre { text-align: center; margin-bottom: 24px; }
        .champ { margin-bottom: 16px; }

        @media (max-width: 720px) {
            header .barre { gap: 12px; }
            .logo-texte, .compte-nom { display: none; }
            main { margin-top: 20px; }
        }
    </style>
</head>
<body>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:if test="${not empty sessionScope.user}">
    <header>
        <div class="barre">
            <a class="logo" href="${ctx}/personnes">
                <span class="logo-marque">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
                        <path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/>
                    </svg>
                </span>
                <span class="logo-texte">Gestion des patients</span>
            </a>
            <nav>
                <a href="${ctx}/personnes" class="${menu == 'personnes' ? 'actif' : ''}">Personnes</a>
                <c:if test="${sessionScope.role == 'MEDECIN'}">
                    <a href="${ctx}/patients" class="${menu == 'patients' ? 'actif' : ''}">Patients</a>
                </c:if>
            </nav>
            <div class="compte">
                <div class="compte-nom">
                    <strong><c:out value="${sessionScope.user}"/></strong>
                    <span>${sessionScope.role == 'MEDECIN' ? 'Medecin' : 'Patient'}</span>
                </div>
                <a class="deconnexion" href="${ctx}/logout" title="Deconnexion" aria-label="Deconnexion">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
                    </svg>
                </a>
            </div>
        </div>
    </header>
</c:if>
<main>
